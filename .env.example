# Gemini API Key (compatible with standard AIza... or AQ... prefixed keys)
GEMINI_API_KEY=

# GitHub Fine-Grained Personal Access Token (public_repo scope only)
GITHUB_TOKEN=

# Isolated Burner Worker Hot Wallet Private Key (for signing task claims/submissions & gas only)
WORKER_PRIVATE_KEY=

# Immutable Cold Wallet Destination Address for all settled USDC payouts
OWNER_COLD_WALLET_ADDRESS=

# Target Settlement Chain Network (options: base, solana)
CHAIN_NETWORK=base

# Minimum USDC balance in Worker Hot Wallet that triggers an automatic sweep to OWNER_COLD_WALLET_ADDRESS
SWEEP_THRESHOLD_USDC=5.0

# Dry-run safety mode (default: true — logs PR drafts and wallet sweeps without broadcasting live transactions)
DRY_RUN_MODE=true

# Telegram Bot Alerting & Kill-Switch Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional RPC & Platform Endpoints
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ALGORA_API_URL=https://console.algora.io/api
GITHUB_API_URL=https://api.github.com
